/*
 * G3 skin: hand-written component layout. Colours of themed parts come from the generated G3Theme.uss
 * (Assets/G3Imported/Gui/Uss, menu G3/GUI/Import); this sheet only places things and adds the colours Game.dll sets
 * in code (Docs/formats-gui.md §5.1). Sizes are 1024x768 reference pixels. See Docs/ui-skin.md.
 */

.g3-root .unity-label {
    padding: 0;
    margin: 0;
}

.g3-fill-parent {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.g3-image {
    -unity-background-scale-mode: stretch-to-fill;
}

.g3-screen {
    overflow: hidden;
}

/* ---- buttons ---- */
.g3-root .g3-button {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.g3-root .g3-button--icon {
    background-image: none;
}

.g3-button__icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.g3-button--icon:hover > .g3-button__icon {
    -unity-background-image-tint-color: rgb(255, 235, 220);
}

/* ---- lists ---- */
.g3-list {
    flex-grow: 1;
}

.g3-list__scroll {
    flex-grow: 1;
}

.g3-list-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.g3-list-row__label {
    flex-grow: 1;
    white-space: normal;
}

.g3-list-row__icon {
    width: 18px;
    height: 18px;
    margin-right: 4px;
    flex-shrink: 0;
}

.g3-list-row__count {
    flex-shrink: 0;
    margin-left: 6px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* [owner] fix-125: station recipes the hero cannot make now: the theme's disabled text colour (#E9D9C7 α 0.5) */
.g3-list-row--unavailable > .g3-list-row__label,
.g3-list-row--unavailable > .g3-list-row__count {
    color: rgba(233, 217, 199, 0.502);
}

.g3-list-row--unavailable > .g3-list-row__icon {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.5);
}

/* ---- tabs ---- */
.g3-tab {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.g3-tab__label {
    -unity-text-align: middle-center;
}

/* ---- item tiles (Docs/formats-gui.md §6.5) ---- */
.g3-tile {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
}

.g3-tile__icon {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 4px;
    bottom: 4px;
}

.g3-tile__quality {
    position: absolute;
    left: 6px;
    bottom: 4px;
    width: 16px;
    height: 16px;
}

.g3-tile__count {
    position: absolute;
    right: 6px;
    bottom: 3px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    color: rgb(199, 166, 72);
}

.g3-tile__digit {
    position: absolute;
    left: 6px;
    top: 3px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(224, 196, 149);
}

/* equipped stacks: blue cell (#12496B, hover/selected #0C7097) instead of the leather brown */
.g3-tile.g3-tile--equipped {
    -unity-background-image-tint-color: rgb(18, 73, 107);
}

.g3-tile.g3-tile--equipped:hover,
.g3-tile.g3-tile--equipped.g3--hover,
.g3-tile.g3-tile--equipped.g3--focus,
.g3-tile.g3-tile--equipped.g3--selected {
    -unity-background-image-tint-color: rgb(12, 112, 151);
}

/* tile grids place their cells absolutely (G3ItemGrid); the viewport clips the scrolled rows */
.g3-grid__viewport {
    overflow: hidden;
}

/* ---- item panel stats ---- */
.g3-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    -unity-font-style: bold;
}

/* ---- frame ---- */
.g3-frame {
    padding: 12px;
}

.g3-frame > .g3-frame__top { position: absolute; left: 12px; right: 12px; top: 0; height: 12px; }
.g3-frame > .g3-frame__bottom { position: absolute; left: 12px; right: 12px; bottom: 0; height: 12px; }
.g3-frame > .g3-frame__left { position: absolute; left: 0; top: 12px; bottom: 12px; width: 12px; }
.g3-frame > .g3-frame__right { position: absolute; right: 0; top: 12px; bottom: 12px; width: 12px; }
.g3-frame > .g3-frame__topleft { position: absolute; left: 0; top: 0; width: 12px; height: 12px; }
.g3-frame > .g3-frame__topright { position: absolute; right: 0; top: 0; width: 12px; height: 12px; }
.g3-frame > .g3-frame__bottomleft { position: absolute; left: 0; bottom: 0; width: 12px; height: 12px; }
.g3-frame > .g3-frame__bottomright { position: absolute; right: 0; bottom: 0; width: 12px; height: 12px; }

.g3-frame__content {
    flex-grow: 1;
}

.g3-tooltip {
    padding: 6px 10px;
}

/* ---- layout slots ---- */
.g3-slot--outlined {
    border-width: 1px;
    border-color: rgba(255, 0, 255, 0.7);
}

/* ---- UI Toolkit scroll bars as G3's (GUI.dll CFFGUIScrollBar, G3ScrollRules): the thumb is at least 8 px and is not
   drawn while nothing scrolls (a disabled scroller); the track and arrows of an always-visible bar stay ---- */
.g3-root .unity-scroller--vertical .unity-base-slider__dragger {
    min-height: 8px;
}
.g3-root .unity-scroller--horizontal .unity-base-slider__dragger {
    min-width: 8px;
}
.g3-root .unity-scroller:disabled .unity-base-slider__dragger {
    visibility: hidden;
}
