// Gothic 3 SpeedTree (original trees generated by Tools/SptBake, imported by G3SpeedTreeImporter): shared vertex logic
// of every pass of G3/SpeedTree, so forward, shadow and depth passes place and bend vertices identically.
//
// Vertex data (see G3SpeedTreeMeshBuilder):
//   POSITION  branch / frond vertex; leaf card centre; billboard: (0, height, 0)
//   NORMAL, TANGENT, COLOR (leaf dimming), TEXCOORD0 atlas / bark uv
//   TEXCOORD1 xy = card corner offset (object metres: leaf x right / y up; billboard x = ±half width)
//             z  = SpeedTree wind weight (0 = rigid), w = wind matrix index (0..3) + 4 × leaf rock group (0..3)
// Modes (material keywords): none = branches / fronds, _G3TREE_LEAF = camera-facing leaf cards,
// _G3TREE_BILLBOARD = upright billboard turned towards the view around the tree axis.
// World remaster v2 trees (Docs/remaster-world.md 10.15, Tools/Remaster/trees) use the same layout and passes with three
// material floats that are 0 on every G3 material: _TreeV2 (static two-sided cards keep their outward normals, the baked
// crown occlusion in the vertex colour replaces the procedural one, _MaskMap AO/thickness, _Snow on up-facing bark) and
// _ImpostorFrames (billboard mode: the atlas holds N yaw frames side by side, picked from the object-space view yaw).
// Trees v3 (Docs/remaster-world.md 10.17) keep G3's meshes and only add material terms behind _TreeV3 (0 on G3's own
// materials): crown ellipsoid normals and occlusion (G3TreeCrownPos), per-tree variation, atlas normal + mask maps.
//
// Wind follows the SpeedTree GPU wind used by Genome: every vertex is turned about the tree base by one of four
// "wind matrices" (here: four phase-shifted oscillators around the global G3Wind bend), scaled by its weight. The
// globals come from G3Wind (Shaders/Wind/G3Wind.hlsl); without a G3Wind component nothing moves.
#ifndef G3_SPEEDTREE_INCLUDED
#define G3_SPEEDTREE_INCLUDED

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Assets/G3/Unity/Shaders/Wind/G3Wind.hlsl"

TEXTURE2D(_BaseMap); SAMPLER(sampler_BaseMap);
TEXTURE2D(_BumpMap); SAMPLER(sampler_BumpMap);
TEXTURE2D(_DetailBumpMap); SAMPLER(sampler_DetailBumpMap);   // world remaster bark (_G3REMASTER_BARK)
TEXTURE2D(_MaskMap); SAMPLER(sampler_MaskMap);               // v2 trees: r = baked card AO, g = thickness (translucency)

CBUFFER_START(UnityPerMaterial)
    float4 _BaseMap_ST;
    half4 _BaseColor;
    half _Cutoff;
    half _Smoothness;
    half _BumpScale;
    half _WindScale;
    half _LeafRock;
    half _LeafRockSpeed;
    half _AmbientBoost;
    half _Translucency;   // world remaster only (_G3REMASTER_FOLIAGE)
    float4 _DetailBumpMap_ST;   // world remaster bark detail: tiling over the bark uv (_G3REMASTER_BARK)
    half _DetailBumpScale;
    half _BarkCavity;
    half _TreeV2;           // v2 replacement tree material (0 = G3)
    half _ImpostorFrames;   // billboard mode: yaw frames in the atlas (0/1 = G3's single 360° billboard)
    half _Snow;             // v2: snow on up-facing surfaces (0..1)
    half _UseMaskMap;       // v2 cards: sample _MaskMap; v3 foliage: _BumpMap is packed (rg normal, b AO, a translucency)
    half _TreeV3;           // trees v3: remastered G3 material (crown normals/AO, variation, atlas normal + mask)
    half _CrownNormal;      // v3: share of the crown ellipsoid normal in the foliage normal (0 = card normal)
    half _CrownAO;          // v3: occlusion depth of the crown interior and underside
    half _TintVariation;    // v3: per-tree brightness/hue variation
CBUFFER_END

struct TreeAttributes
{
    float4 positionOS : POSITION;
    float3 normalOS   : NORMAL;
    float4 tangentOS  : TANGENT;
    half4 color       : COLOR;
    float2 uv         : TEXCOORD0;
    float4 data       : TEXCOORD1;
    UNITY_VERTEX_INPUT_INSTANCE_ID
};

struct TreeVertex
{
    float3 positionWS;
    float3 normalWS;
    float4 tangentWS;
    float2 uv;          // TEXCOORD0, or the impostor frame's part of the atlas
};

// Impostor frame of the view yaw (mirrors TreeV2Plan.ImpostorFrame): frame f was baked from yaw f * 360°/frames,
// yaw 0 = viewer on the object's +z, +90° = on +x.
float G3TreeImpostorFrame(float3 viewBackWS, float frames)
{
    float3 d = mul((float3x3)UNITY_MATRIX_I_M, viewBackWS);
    float yaw = atan2(d.x, d.z);
    float f = floor(yaw / (2 * PI) * frames + 0.5);
    return f - frames * floor(f / frames);
}

float3 G3TreeRotate(float3 v, float3 axis, float angle)
{
    float s, c;
    sincos(angle, s, c);
    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1 - c);
}

// Bend angle (rad) of wind matrix `index` for the tree standing at originWS.
float G3TreeWindAngle(float index, float3 originWS)
{
    float t = G3_WIND_TIME;
    float phase = dot(originWS.xz, float2(0.173, 0.219));
    float4 freq = float4(0.9, 1.23, 0.75, 1.54);
    float4 offs = float4(0.0, 1.9, 3.7, 5.3);
    int i = (int)index;
    float osc = sin(t * freq[i] + offs[i] + phase) * 0.7 + sin(t * freq[i] * 2.3 + offs[i] * 1.7 + phase) * 0.3;
    float gust = _G3WindTree.z * G3WindGustField(originWS.xz);
    return (_G3WindTree.x + gust + _G3WindTree.y * osc) * _WindScale;
}

// relWS: vertex relative to the tree base. Turns it about the horizontal axis across the wind.
float3 G3TreeWind(float3 relWS, float weight, float index, float3 originWS)
{
    float2 dir = _G3WindDirection.xz;
    if (weight <= 0 || dot(dir, dir) < 1e-6) return relWS;
    float3 axis = normalize(float3(dir.y, 0, -dir.x));
    return G3TreeRotate(relWS, axis, G3TreeWindAngle(index, originWS) * weight);
}

TreeVertex G3TreeVertex(TreeAttributes v)
{
    TreeVertex o;
    float3 originWS = UNITY_MATRIX_M._m03_m13_m23;
    float scale = length(UNITY_MATRIX_M._m01_m11_m21);
    float windIndex = fmod(v.data.w + 0.25, 4) - 0.25;
    float rockGroup = floor((v.data.w + 0.25) / 4);
    // The current view: the camera in colour / depth passes, the light in the shadow pass (cards then face the light).
    float3 viewRight = UNITY_MATRIX_V[0].xyz;
    float3 viewUp = UNITY_MATRIX_V[1].xyz;
    float3 viewBack = UNITY_MATRIX_V[2].xyz;
    o.uv = v.uv;

#if defined(_G3TREE_LEAF)
    float3 centerWS = TransformObjectToWorld(v.positionOS.xyz);
    float3 rel = G3TreeWind(centerWS - originWS, v.data.z, windIndex, originWS);
    float2 c = v.data.xy * scale;
    float rock = _LeafRock * (1 + _G3RemasterWind.y) * (0.35 + saturate(_G3WindDirection.w)) *
                 sin(G3_WIND_TIME * _LeafRockSpeed * (1 + 0.21 * rockGroup) + rockGroup * 1.7 + dot(centerWS, float3(0.37, 0.21, 0.29)));
    float rs, rc;
    sincos(rock, rs, rc);
    c = float2(c.x * rc - c.y * rs, c.x * rs + c.y * rc);
    o.positionWS = originWS + rel + viewRight * c.x + viewUp * c.y;
    o.normalWS = normalize(TransformObjectToWorldNormal(v.normalOS) + viewBack * 0.5);
    o.tangentWS = float4(viewRight, 1);
#elif defined(_G3TREE_BILLBOARD)
    float3 right = float3(viewRight.x, 0, viewRight.z);
    right = dot(right, right) > 1e-6 ? normalize(right) : float3(1, 0, 0);
    float3 back = float3(viewBack.x, 0, viewBack.z);
    back = dot(back, back) > 1e-6 ? normalize(back) : float3(0, 0, 1);
    o.normalWS = normalize(back + float3(0, 0.6, 0));
    o.tangentWS = float4(right, 1);
    float widthScale = scale;
    [branch] if (_ImpostorFrames > 1.5)
    {
        // v2 impostor: N baked yaw frames, horizontal scale from the object's x axis (the swap may widen a model)
        o.uv.x = (G3TreeImpostorFrame(viewBack, _ImpostorFrames) + v.uv.x) / _ImpostorFrames;
        widthScale = length(UNITY_MATRIX_M._m00_m10_m20);
        o.normalWS = back;
        o.tangentWS = float4(right, -1);   // bitangent = cross(back, right) * -1 = up: the baked normal map's +y
    }
    o.positionWS = TransformObjectToWorld(v.positionOS.xyz) + right * (v.data.x * widthScale);
#else
    float3 positionWS = TransformObjectToWorld(v.positionOS.xyz);
    o.positionWS = originWS + G3TreeWind(positionWS - originWS, v.data.z, windIndex, originWS);
    o.normalWS = TransformObjectToWorldNormal(v.normalOS);
    o.tangentWS = float4(TransformObjectToWorldDir(v.tangentOS.xyz), v.tangentOS.w * GetOddNegativeScale());
#endif
    return o;
}

// Trees v3 (Docs/remaster-world.md 10.17): the tree's crown as an ellipsoid from the renderer bounds (SRP batcher:
// UnityPerDraw; GPU Resident Drawer: mesh bounds x instance matrix). Returns the position in crown units: (0,0,0) at the
// crown centre (60 % of the height), length 1 on its surface. The direction is the foliage's "crown normal" (a whole
// crown lit as one volume instead of every card facing the camera) and the length its depth for the interior occlusion.
float3 G3TreeCrownPos(float3 positionWS)
{
    float3 mn = unity_RendererBounds_Min.xyz;
    float3 mx = unity_RendererBounds_Max.xyz;
    float3 ext = (mx - mn) * 0.5;
    [branch] if (!(ext.y > 0.25 && ext.y < 500))   // no bounds: a 8 x 10 m tree at the origin, scaled
    {
        float3 o = UNITY_MATRIX_M._m03_m13_m23;
        float sc = length(UNITY_MATRIX_M._m01_m11_m21);
        mn = o - float3(4, 0, 4) * sc;
        mx = o + float3(4, 10, 4) * sc;
        ext = (mx - mn) * 0.5;
    }
    float3 c = float3(mn.x + ext.x, lerp(mn.y, mx.y, 0.6), mn.z + ext.z);
    float3 r = max(float3(ext.x, ext.y * 0.85, ext.z), 0.5);
    return (positionWS - c) / r;
}

// v3 per-tree variation from the instance position (stable, no per-instance data): x brightness, y hue (-1..1)
half2 G3TreeVariation()
{
    float2 o = UNITY_MATRIX_M._m03_m23;
    return half2(frac(sin(dot(o, float2(12.9898, 78.233))) * 43758.5453),
                 frac(sin(dot(o, float2(39.3468, 11.1351))) * 24634.6345)) * 2 - 1;
}

half3 G3TreeVary(half3 albedo, half amount)
{
    half2 v = G3TreeVariation();
    half3 hue = v.y > 0 ? lerp(half3(1, 1, 1), half3(1.08, 1.02, 0.84), v.y)    // warmer, yellower
                        : lerp(half3(1, 1, 1), half3(0.92, 1.0, 1.06), -v.y);   // cooler, bluer
    return albedo * (1 + amount * v.x) * lerp(half3(1, 1, 1), hue, saturate(amount * 6));
}

// World remaster v2 (Docs/remaster-world.md 10.4, global, set by G3WorldV2; zero = unchanged):
// x on, y crown occlusion, z coverage-preserving mip alpha boost, w grass translucency (unused here)
float4 _G3V2Foliage;

half G3TreeAlpha(float2 uv)
{
    half a = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, uv).a * _BaseColor.a;
    [branch] if (_G3V2Foliage.z > 0 && _TreeV2 < 0.5)   // v2 atlases keep coverage in their mips (importer): no boost
    {
        // leaf cards keep their coverage in the distance (mip alpha boost like G3/Vegetation; atlases are 2048)
        float2 t = uv * 2048;
        float2 dx = ddx(t), dy = ddy(t);
        float mip = 0.5 * log2(max(dot(dx, dx), dot(dy, dy)));
        a *= 1 + max(0, mip) * _G3V2Foliage.z;
    }
    return a;
}

#endif
