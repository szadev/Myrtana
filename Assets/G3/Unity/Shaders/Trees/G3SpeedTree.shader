// Original Gothic 3 SpeedTrees (meshes generated by SpeedTreeRT 4.0 via Tools/SptBake, see Docs/formats-speedtree.md §8).
// One shader for bark (opaque, optional normal map), fronds (alpha-tested, two-sided), leaf cards (alpha-tested,
// camera-facing, rocking) and the far billboard (alpha-tested, upright, view-facing); vertex logic in G3SpeedTree.hlsl.
// URP Forward+ lighting (UniversalFragmentPBR), shadows, SSAO depth-normals, LOD cross-fade, SRP batcher and
// DOTS instancing (GPU Resident Drawer).
Shader "G3/SpeedTree"
{
    Properties
    {
        _BaseMap("Diffuse", 2D) = "white" {}
        _BaseColor("Tint", Color) = (1,1,1,1)
        _Cutoff("Alpha cutoff (SpeedTree 84/255)", Range(0,1)) = 0.33
        _Smoothness("Smoothness", Range(0,1)) = 0.1
        [Normal][NoScaleOffset] _BumpMap("Normal map (bark)", 2D) = "bump" {}
        _BumpScale("Normal scale", Float) = 1
        _WindScale("Wind: bend multiplier on the SpeedTree weights", Range(0, 20)) = 6
        _LeafRock("Leaf rocking amplitude (rad)", Range(0, 0.5)) = 0.06
        _LeafRockSpeed("Leaf rocking speed (rad/s)", Range(0, 10)) = 2.2
        _AmbientBoost("Ambient multiplier", Range(0, 2)) = 1
        [Enum(UnityEngine.Rendering.CullMode)] _Cull("Cull", Float) = 2
        [Toggle(_ALPHATEST_ON)] _AlphaClip("Alpha clip", Float) = 1
        [KeywordEnum(Mesh, Leaf, Billboard)] _G3Tree("Mode", Float) = 0
        // World remaster only (Docs/remaster-world.md; set on the override copies of leaf/frond materials)
        [Toggle(_G3REMASTER_FOLIAGE)] _G3RemasterFoliage("Remaster foliage translucency", Float) = 0
        _Translucency("Back-light translucency", Range(0, 1)) = 0.3
        // World remaster bark: a tiling CC0 bark normal over the (upscaled) bark map, plus cavity darkening from it
        [Toggle(_G3REMASTER_BARK)] _G3RemasterBark("Remaster bark detail", Float) = 0
        [Normal] _DetailBumpMap("Bark detail normal (CC0)", 2D) = "bump" {}
        _DetailBumpScale("Bark detail strength", Range(0, 2)) = 0.8
        _BarkCavity("Bark cavity darkening", Range(0, 1)) = 0.35
        // World remaster v2 replacement trees (Docs/remaster-world.md 10.15; 0 on every G3 material)
        _TreeV2("v2 tree (cards keep outward normals, baked AO)", Float) = 0
        _ImpostorFrames("v2 impostor yaw frames (billboard mode)", Float) = 0
        _Snow("v2 snow on up-facing surfaces", Range(0, 1)) = 0
        _UseMaskMap("v2 card mask map (v3: AO/translucency in _BumpMap B/A)", Float) = 0
        [NoScaleOffset] _MaskMap("v2 card mask (r AO, g thickness)", 2D) = "white" {}
        // Trees v3 (Docs/remaster-world.md 10.17): G3's own trees with remastered materials (0 on every G3 material)
        _TreeV3("v3 remastered G3 tree material", Float) = 0
        _CrownNormal("v3 crown normal share (foliage)", Range(0, 1)) = 0
        _CrownAO("v3 crown interior occlusion", Range(0, 1)) = 0
        _TintVariation("v3 per-tree tint variation", Range(0, 0.3)) = 0
    }

    HLSLINCLUDE
    #include "Assets/G3/Unity/Shaders/Trees/G3SpeedTree.hlsl"
    ENDHLSL

    SubShader
    {
        Tags { "RenderType" = "TransparentCutout" "RenderPipeline" = "UniversalPipeline" "Queue" = "AlphaTest" }
        Cull [_Cull]

        Pass
        {
            Name "ForwardLit"
            Tags { "LightMode" = "UniversalForward" }

            HLSLPROGRAM
            #pragma target 3.0
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma shader_feature_local_vertex _ _G3TREE_LEAF _G3TREE_BILLBOARD
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma shader_feature_local _NORMALMAP
            #pragma shader_feature_local_fragment _G3REMASTER_FOLIAGE
            #pragma shader_feature_local_fragment _G3REMASTER_BARK
            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE _MAIN_LIGHT_SHADOWS_SCREEN
            #pragma multi_compile _ _ADDITIONAL_LIGHTS_VERTEX _ADDITIONAL_LIGHTS
            #pragma multi_compile_fragment _ _ADDITIONAL_LIGHT_SHADOWS
            #pragma multi_compile_fragment _ _SHADOWS_SOFT _SHADOWS_SOFT_LOW _SHADOWS_SOFT_MEDIUM _SHADOWS_SOFT_HIGH
            #pragma multi_compile_fragment _ _SCREEN_SPACE_OCCLUSION
            #pragma multi_compile _ _CLUSTER_LIGHT_LOOP
            #pragma multi_compile _ _LIGHT_LAYERS
            #pragma multi_compile _ LOD_FADE_CROSSFADE
            #pragma multi_compile_instancing
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DOTS.hlsl"
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Fog.hlsl"
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/ProbeVolumeVariants.hlsl"

            #define _ENVIRONMENTREFLECTIONS_OFF
            #define _SPECULARHIGHLIGHTS_OFF
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/LODCrossFade.hlsl"
            #include "Assets/G3/Unity/Shaders/Remaster/G3RemasterTune.hlsl"

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv         : TEXCOORD0;
                float3 positionWS : TEXCOORD1;
                half3 normalWS    : TEXCOORD2;
                half4 tangentWS   : TEXCOORD3;
                half4 color       : TEXCOORD4;
                half fogFactor    : TEXCOORD5;
                half3 vertexSH    : TEXCOORD6;
                float3 shadowPositionWS : TEXCOORD7;
                float3 crownPos   : TEXCOORD8;   // v3: position in crown units (billboard: x = side of the card)
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            Varyings Vert(TreeAttributes v)
            {
                Varyings o = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(v);
                UNITY_TRANSFER_INSTANCE_ID(v, o);
                TreeVertex t = G3TreeVertex(v);
                o.positionCS = TransformWorldToHClip(t.positionWS);
                o.positionWS = t.positionWS;
                o.shadowPositionWS = t.positionWS;
            #if defined(_G3TREE_BILLBOARD)
                // The billboard casts its shadow as a light-facing card through the tree axis, which would darken the
                // half of the camera-facing card behind it. Receive shadows in front of that card instead.
                o.shadowPositionWS += GetMainLight().direction * length(t.positionWS.xz - UNITY_MATRIX_M._m03_m23);
            #endif
                o.normalWS = t.normalWS;
                o.tangentWS = t.tangentWS;
                o.uv = TRANSFORM_TEX(t.uv, _BaseMap);
                o.color = v.color;
                o.fogFactor = ComputeFogFactor(o.positionCS.z);
                o.vertexSH = SampleSHVertex(normalize(lerp(t.normalWS, float3(0, 1, 0), 0.3)));
                o.crownPos = 0;
                [branch] if (_TreeV3 > 0.5)
                {
                    o.crownPos = G3TreeCrownPos(t.positionWS);
                #if defined(_G3TREE_BILLBOARD)
                    o.crownPos.x = v.data.x > 0 ? 1 : -1;   // across the view-facing card: -1 left edge .. 1 right edge
                    o.crownPos.z = 0;
                #endif
                }
                return o;
            }

            half4 Frag(Varyings i, FRONT_FACE_TYPE face : FRONT_FACE_SEMANTIC) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(i);
                half4 tex = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, i.uv);
            #if defined(_ALPHATEST_ON)
                clip(G3TreeAlpha(i.uv) - _Cutoff);   // = tex.a * _BaseColor.a unless the v2 coverage boost is on
            #endif
            #if defined(LOD_FADE_CROSSFADE)
                LODFadeCrossFade(i.positionCS);
            #endif

                half3 n = normalize(i.normalWS);
            #if !defined(_G3TREE_LEAF) && !defined(_G3TREE_BILLBOARD)
                if (_TreeV2 < 0.5) n = IS_FRONT_VFACE(face, n, -n);   // two-sided fronds (v2 cards keep outward normals)
            #endif
                half crownAO = 1;
            #if defined(_G3REMASTER_FOLIAGE)
                [branch] if (_TreeV3 > 0.5)
                {
                    // v3: the crown is lit as one volume (ellipsoid normal) and its interior and underside get less sky
                    float3 cp = i.crownPos;
                    half3 crownN;
                #if defined(_G3TREE_BILLBOARD)
                    half3 right = normalize(i.tangentWS.xyz);
                    half3 back = normalize(half3(i.normalWS.x, 0, i.normalWS.z) + half3(0, 0, 1e-4));
                    half dx = clamp(cp.x, -1, 1);
                    crownN = normalize(right * dx + half3(0, 1, 0) * (cp.y * 0.7 + 0.2) + back * sqrt(saturate(1 - dx * dx)));
                    crownAO = lerp(1 - _CrownAO * 0.6, 1, saturate(cp.y * 0.5 + 0.6));
                #else
                    // up-biased (sky-facing undersides read as shade, not black); deep inside the crown the card
                    // normal stays (the centre has no meaningful direction: inner dead twigs went black)
                    half cl = saturate(length(cp));
                    crownN = normalize(float3(cp.x, max(cp.y, 0) + 0.5, cp.z));   // never down: the lower crown read black (runner A|B)
                    crownAO = max(lerp(1 - _CrownAO, 1, smoothstep(0.1, 0.9, cl)) *
                                  lerp(1 - _CrownAO * 0.3, 1, saturate(cp.y * 0.5 + 0.7)), 0.55);
                    crownN = normalize(lerp(n, crownN, saturate(cl * 1.5)) + crownN * 1e-3);
                #endif
                    n = normalize(lerp(n, crownN, _CrownNormal) + crownN * 1e-3);
                }
            #endif
                half4 packedMask = half4(0.5, 0.5, 1, 1);   // v3 foliage: _BumpMap = normal xy + b AO + a translucency
            #if defined(_NORMALMAP)
                half4 bump = SAMPLE_TEXTURE2D(_BumpMap, sampler_BumpMap, i.uv);
                half3 nts;
                [branch] if (_TreeV3 > 0.5 && _UseMaskMap > 0.5)
                {
                    packedMask = bump;   // plain linear BC7 texture (one sample for normal and mask)
                    nts.xy = (bump.rg * 2 - 1) * _BumpScale;
                    nts.z = sqrt(saturate(1 - dot(nts.xy, nts.xy)));
                }
                else nts = UnpackNormalScale(bump, _BumpScale);
                half3 t = normalize(i.tangentWS.xyz);   // v3: fronds get no normal map (G3's frond meshes: no usable tangents)
                if (_TreeV3 > 0.5) t = normalize(t - n * dot(n, t) + 1e-4);   // the crown normal tilted n
                half3 b = cross(n, t) * (i.tangentWS.w > 0 ? 1 : -1);
                n = normalize(TransformTangentToWorld(nts, half3x3(t, b, n)));
            #endif
            #if defined(_G3REMASTER_BARK) && !defined(_G3TREE_LEAF) && !defined(_G3TREE_BILLBOARD)
                half barkAO;
                {
                    // tiling CC0 bark normal (whiteout in tangent space of the bark), fades by 40 m; its slope -> cavity
                    half fade = saturate(2 - distance(i.positionWS, GetCameraPositionWS()) / 20.0);
                    half3 dn = UnpackNormalScale(SAMPLE_TEXTURE2D(_DetailBumpMap, sampler_DetailBumpMap,
                                                 i.uv * _DetailBumpMap_ST.xy + _DetailBumpMap_ST.zw), _DetailBumpScale * G3TUNE_BARK * fade);
                    half3 tb = normalize(i.tangentWS.xyz);
                    half3 bb = cross(n, tb) * (i.tangentWS.w > 0 ? 1 : -1);
                    n = normalize(TransformTangentToWorld(dn, half3x3(tb, bb, n)));
                    barkAO = 1 - _BarkCavity * G3TUNE_BARK * saturate(1 - dn.z) * 4;
                }
            #endif

                InputData input = (InputData)0;
                input.positionWS = i.positionWS;
                input.positionCS = i.positionCS;
                input.normalWS = n;
                input.viewDirectionWS = GetWorldSpaceNormalizeViewDir(i.positionWS);
                input.shadowCoord = TransformWorldToShadowCoord(i.shadowPositionWS);
                input.fogCoord = i.fogFactor;
                input.normalizedScreenSpaceUV = GetNormalizedScreenSpaceUV(i.positionCS);
                input.bakedGI = SampleSHPixel(i.vertexSH, n) * _AmbientBoost;
                input.shadowMask = half4(1, 1, 1, 1);

                SurfaceData s = (SurfaceData)0;
                s.albedo = tex.rgb * _BaseColor.rgb * i.color.rgb;
                half thickness = 1;
                half maskAO = 1;
                [branch] if (_TreeV3 > 0.5)
                {
                    s.albedo = G3TreeVary(s.albedo, _TintVariation);
                    if (_UseMaskMap > 0.5)   // packed into the normal map's B/A (sampled above)
                    {
                        maskAO = packedMask.b;
                        thickness = packedMask.a;
                    }
                    // half of the occlusion also on the direct light (the shadow map misses the inner leaves past 150 m)
                    s.albedo *= lerp(1, crownAO * maskAO, 0.35);
                }
                [branch] if (_TreeV2 > 0.5)
                {
                    // v2: snow settles on up-facing bark (the card atlases have their own), soft edge by the slope
                    s.albedo = lerp(s.albedo, half3(0.82, 0.84, 0.88) * i.color.rgb, _Snow * saturate((n.y - 0.3) * 2.5));
                    [branch] if (_UseMaskMap > 0.5)
                    {
                        half4 mask = SAMPLE_TEXTURE2D(_MaskMap, sampler_MaskMap, i.uv);
                        s.albedo *= lerp(1, mask.r, 0.6);   // the vertex colour already holds the crown occlusion
                        thickness = mask.g;
                    }
                }
                s.alpha = 1;
                s.smoothness = _Smoothness;
                s.occlusion = crownAO * maskAO;
                s.normalTS = half3(0, 0, 1);
            #if defined(_G3REMASTER_BARK) && !defined(_G3TREE_LEAF) && !defined(_G3TREE_BILLBOARD)
                s.occlusion = saturate(barkAO);
            #endif
            #if defined(_G3REMASTER_FOLIAGE)
                [branch] if (_G3V2Foliage.x > 0 && _TreeV2 < 0.5 && _TreeV3 < 0.5)   // r3 copies; v3 has its crown AO
                {
                    // v2 crown occlusion: leaves near the trunk axis and low in the crown get less sky (reads as volume)
                    float3 origin = UNITY_MATRIX_M._m03_m13_m23;
                    float hgt = max(i.positionWS.y - origin.y, 0.5);
                    float r = length(i.positionWS.xz - origin.xz);
                    float interior = saturate(1 - r / max(hgt * 0.45, 1.0));
                    s.occlusion *= 1 - _G3V2Foliage.y * interior * 0.85;
                }
            #endif

                half4 color = UniversalFragmentPBR(input, s);
            #if defined(_G3REMASTER_FOLIAGE)
                {
                    // light through the leaves when looking towards the sun + sheen
                    Light sun = GetMainLight(input.shadowCoord);
                    color.rgb += G3FoliageLight(s.albedo, input.normalWS, input.viewDirectionWS, sun.direction, sun.color,
                                                sun.shadowAttenuation, _Translucency * thickness);
                }
            #endif
                color.rgb = MixFog(color.rgb, input.fogCoord);
                color.a = 1;
                return color;
            }
            ENDHLSL
        }

        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }
            ZWrite On ZTest LEqual ColorMask 0

            HLSLPROGRAM
            #pragma target 3.0
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma shader_feature_local_vertex _ _G3TREE_LEAF _G3TREE_BILLBOARD
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile _ LOD_FADE_CROSSFADE
            #pragma multi_compile_instancing
            #pragma multi_compile_vertex _ _CASTING_PUNCTUAL_LIGHT_SHADOW
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DOTS.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/LODCrossFade.hlsl"

            float3 _LightDirection;
            float3 _LightPosition;

            struct Varyings { float4 positionCS : SV_POSITION; float2 uv : TEXCOORD0; UNITY_VERTEX_INPUT_INSTANCE_ID };

            Varyings Vert(TreeAttributes v)
            {
                Varyings o = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(v);
                UNITY_TRANSFER_INSTANCE_ID(v, o);
                TreeVertex t = G3TreeVertex(v);
            #if _CASTING_PUNCTUAL_LIGHT_SHADOW
                float3 l = normalize(_LightPosition - t.positionWS);
            #else
                float3 l = _LightDirection;
            #endif
            #if defined(_G3TREE_LEAF) || defined(_G3TREE_BILLBOARD)
                float3 nb = l;   // cards face the light here: bias along it
            #else
                float3 nb = t.normalWS;
            #endif
                o.positionCS = ApplyShadowClamping(TransformWorldToHClip(ApplyShadowBias(t.positionWS, nb, l)));
                o.uv = TRANSFORM_TEX(t.uv, _BaseMap);
                return o;
            }

            half4 Frag(Varyings i) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(i);
            #if defined(_ALPHATEST_ON)
                clip(G3TreeAlpha(i.uv) - _Cutoff);
            #endif
            #if defined(LOD_FADE_CROSSFADE)
                LODFadeCrossFade(i.positionCS);
            #endif
                return 0;
            }
            ENDHLSL
        }

        // Remaster TAA (Docs/remaster-world.md 11.7): per-pixel motion of the wind, evaluated at this and at the previous
        // frame's wind clock (G3Wind _G3WindTimePrev), so TAA reprojects swaying crowns instead of smearing them. Drawn only
        // while URP renders motion vectors (TAA on); trees beyond _G3MotionVectors.x metres collapse (camera motion only).
        Pass
        {
            Name "MotionVectors"
            Tags { "LightMode" = "MotionVectors" }
            ColorMask RG

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma shader_feature_local_vertex _ _G3TREE_LEAF _G3TREE_BILLBOARD
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile _ LOD_FADE_CROSSFADE
            #pragma multi_compile_instancing
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DOTS.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/LODCrossFade.hlsl"

            float4 _G3MotionVectors;   // x max distance of per-object wind motion (m), 0 = none

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
                float4 curCS : TEXCOORD1;
                float4 prevCS : TEXCOORD2;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            Varyings Vert(TreeAttributes v)
            {
                Varyings o = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(v);
                UNITY_TRANSFER_INSTANCE_ID(v, o);
                float3 originWS = UNITY_MATRIX_M._m03_m13_m23;
                if (distance(originWS, _WorldSpaceCameraPos.xyz) > _G3MotionVectors.x) { o.positionCS = float4(0, 0, -2, 1); return o; }
                TreeVertex t = G3TreeVertex(v);
                o.positionCS = TransformWorldToHClip(t.positionWS);
                o.uv = TRANSFORM_TEX(t.uv, _BaseMap);
                o.curCS = mul(_NonJitteredViewProjMatrix, float4(t.positionWS, 1));
                g3WindTimeShift = _G3WindTimePrev - _G3WindTime;
                float3 prevWS = G3TreeVertex(v).positionWS;
                g3WindTimeShift = 0;
                prevWS = mul(UNITY_PREV_MATRIX_M, mul(UNITY_MATRIX_I_M, float4(prevWS, 1))).xyz;   // a moved tree (rare)
                o.prevCS = mul(_PrevViewProjMatrix, float4(prevWS, 1));
                return o;
            }

            float4 Frag(Varyings i) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(i);
            #if defined(_ALPHATEST_ON)
                clip(G3TreeAlpha(i.uv) - _Cutoff);
            #endif
            #if defined(LOD_FADE_CROSSFADE)
                LODFadeCrossFade(i.positionCS);
            #endif
                return float4(G3WindMotion(i.curCS, i.prevCS), 0, 0);
            }
            ENDHLSL
        }

        Pass
        {
            Name "DepthOnly"
            Tags { "LightMode" = "DepthOnly" }
            ZWrite On ColorMask R

            HLSLPROGRAM
            #pragma target 3.0
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma shader_feature_local_vertex _ _G3TREE_LEAF _G3TREE_BILLBOARD
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile _ LOD_FADE_CROSSFADE
            #pragma multi_compile_instancing
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DOTS.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/LODCrossFade.hlsl"

            struct Varyings { float4 positionCS : SV_POSITION; float2 uv : TEXCOORD0; UNITY_VERTEX_INPUT_INSTANCE_ID };

            Varyings Vert(TreeAttributes v)
            {
                Varyings o = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(v);
                UNITY_TRANSFER_INSTANCE_ID(v, o);
                TreeVertex t = G3TreeVertex(v);
                o.positionCS = TransformWorldToHClip(t.positionWS);
                o.uv = TRANSFORM_TEX(t.uv, _BaseMap);
                return o;
            }

            half4 Frag(Varyings i) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(i);
            #if defined(_ALPHATEST_ON)
                clip(G3TreeAlpha(i.uv) - _Cutoff);
            #endif
            #if defined(LOD_FADE_CROSSFADE)
                LODFadeCrossFade(i.positionCS);
            #endif
                return i.positionCS.z;
            }
            ENDHLSL
        }

        Pass
        {
            Name "DepthNormals"
            Tags { "LightMode" = "DepthNormals" }
            ZWrite On

            HLSLPROGRAM
            #pragma target 3.0
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma shader_feature_local_vertex _ _G3TREE_LEAF _G3TREE_BILLBOARD
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile _ LOD_FADE_CROSSFADE
            #pragma multi_compile_instancing
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DOTS.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/LODCrossFade.hlsl"

            struct Varyings { float4 positionCS : SV_POSITION; float2 uv : TEXCOORD0; half3 normalWS : TEXCOORD1; float3 crownPos : TEXCOORD2; UNITY_VERTEX_INPUT_INSTANCE_ID };

            Varyings Vert(TreeAttributes v)
            {
                Varyings o = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(v);
                UNITY_TRANSFER_INSTANCE_ID(v, o);
                TreeVertex t = G3TreeVertex(v);
                o.positionCS = TransformWorldToHClip(t.positionWS);
                o.normalWS = t.normalWS;
                o.uv = TRANSFORM_TEX(t.uv, _BaseMap);
                o.crownPos = _TreeV3 > 0.5 ? G3TreeCrownPos(t.positionWS) : 0;
                return o;
            }

            half4 Frag(Varyings i, FRONT_FACE_TYPE face : FRONT_FACE_SEMANTIC) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(i);
            #if defined(_ALPHATEST_ON)
                clip(G3TreeAlpha(i.uv) - _Cutoff);
            #endif
            #if defined(LOD_FADE_CROSSFADE)
                LODFadeCrossFade(i.positionCS);
            #endif
                half3 n = normalize(i.normalWS);
            #if !defined(_G3TREE_LEAF) && !defined(_G3TREE_BILLBOARD)
                if (_TreeV2 < 0.5) n = IS_FRONT_VFACE(face, n, -n);
            #endif
            #if !defined(_G3TREE_BILLBOARD)
                [branch] if (_TreeV3 > 0.5 && _CrownNormal > 0)   // v3: SSAO sees the crown volume like the lighting
                {
                    half3 crownN = normalize(float3(i.crownPos.x, max(i.crownPos.y, 0) + 0.5, i.crownPos.z));
                    n = normalize(lerp(n, crownN, _CrownNormal) + crownN * 1e-3);
                }
            #endif
                return half4(NormalizeNormalPerPixel(n), 0);
            }
            ENDHLSL
        }
    }
    FallBack "Hidden/Universal Render Pipeline/FallbackError"
}
