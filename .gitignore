/Library/
/Temp/
/Work/
/Logs/
/UserSettings/
/obj/
/Tools/**/bin/
/Tools/**/obj/
*.csproj
!/Tools/**/*.csproj
*.sln

# Generated from the original game files by the importer (regenerable, game-derived content)
/Assets/G3Imported/
/Assets/G3Imported.meta
# Local caches / tools output
/Tools/**/__pycache__/
*.blend1
.vs/
.idea/
# Scenes generated by the importer (regenerable)
/Assets/Scenes/World/Cells/
/Assets/Scenes/World/Cells.meta
/Assets/Scenes/World/G3World_Master.unity
/Assets/Scenes/World/G3World_Master.unity.meta
/Assets/Scenes/G3_Region_*.unity
/Assets/Scenes/G3_Region_*.unity.meta
/Assets/Scenes/Test_NPCs.unity
/Assets/Scenes/Test_NPCs.unity.meta

# Player builds (performance tests)
/Builds/

# Generated by the Myrtana G3 importer from the game files (regenerable; menu Myrtana/Content or G3Cli content)
/Assets/StreamingAssets/Content/Gothic3/
/Assets/StreamingAssets/Content/Gothic3.meta
/Assets/StreamingAssets/Voice/
/Assets/StreamingAssets/Voice.meta
# Game-derived runtime data outside Assets (voice clips + lip-sync; never imported by Unity; copied next to the exe on build)
/GameData/

# Intro/credits/logo videos converted by the owner from Data/Video/*.bik (Docs/game-start.md)
/Assets/StreamingAssets/Video/
/Assets/StreamingAssets/Video.meta
# fix-152: launcher built by Tools/Launcher/build.cmd without an output path
/Tools/Launcher/bin/
